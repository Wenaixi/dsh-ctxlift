{
  "name": "dsh-ctxlift",
  "version": "0.2.0",
  "description": "精细控制全局与项目级 AGENTS.md / CLAUDE.md 注入截断的 DSH 插件，附 Web 端全局指令在线编辑器",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/dsh-ctxlift.git"
  },
  "homepage": "https://github.com/Wenaixi/dsh-ctxlift#readme",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-ctxlift/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dsh-ctxlift.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.1 <=0.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/isolated-real-acceptance.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "instructions",
    "agents",
    "claude",
    "context"
  ],
  "author": "Wenxi",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <=0.2.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "icon": "dsh-ctxlift.png"
}
