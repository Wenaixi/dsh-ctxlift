{
  "name": "dsh-ctxlift",
  "version": "0.1.0",
  "description": "DSH workspace instructions granular truncation controller, global CLAUDE.md support, and web instruction editor",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.js",
      "default": "./lib/client/index.js"
    },
    "./remote": {
      "types": "./lib/typert.d.ts",
      "import": "./lib/typert.js",
      "default": "./lib/typert.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/**/*.test.js test/**/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "instructions",
    "agents",
    "claude",
    "context"
  ],
  "author": "Wenxi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
